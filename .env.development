# ============================================================
# AMASCI - Development Environment
# ============================================================

APP_NAME=AMASCI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=1

SECRET_KEY=dev-secret-key-change-in-production-abc123
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=amasci_user
POSTGRES_PASSWORD=amasci_dev_pass
POSTGRES_DB=amasci_db
DATABASE_URL=postgresql+asyncpg://amasci_user:amasci_dev_pass@localhost:5432/amasci_db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pass
NEO4J_DATABASE=neo4j

UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models
LOG_DIR=./data/logs
MAX_UPLOAD_SIZE_MB=500

LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7

TPKE_CONFIDENCE_THRESHOLD=0.70
TPKE_FREQUENCY_THRESHOLD=3
TPKE_TOP_K=3
TPKE_DECAY_RATE=0.05
TPKE_REMOVAL_THRESHOLD=0.10
TPKE_WINDOW_SIZE_DAYS=30

VITE_API_BASE_URL=http://localhost:8000
