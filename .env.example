# ============================================================
# AMASCI - Example Environment Configuration
# ============================================================

APP_NAME=AMASCI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=1

SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=amasci_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=amasci_db
DATABASE_URL=postgresql+asyncpg://amasci_user:your_postgres_password@localhost:5432/amasci_db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models
LOG_DIR=./data/logs
MAX_UPLOAD_SIZE_MB=500

LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7

TPKE_CONFIDENCE_THRESHOLD=0.6
TPKE_FREQUENCY_THRESHOLD=3
TPKE_DECAY_RATE=0.1
TPKE_WINDOW_SIZE_DAYS=90

# --- Holdout / Evaluation ---
HOLDOUT_START_DATE=2017-10-01
USE_REAL_HOLDOUT_ACTUALS=true
ACTUALS_DIR=data/actuals_real

# Graph enrichment — False means Neo4j outage aborts training (safe default)
FAIL_ON_GRAPH_ENRICHMENT_ERROR=false
USE_SYNTHETIC_FALLBACK=false
RESET_CYCLE_ON_STARTUP=false
