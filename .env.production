# ============================================================
# AMASCI - Production Environment
# IMPORTANT: Replace all placeholder values before deployment
# Use secrets management (Vault, AWS SSM, GitHub Secrets)
# ============================================================

APP_NAME=AMASCI
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=${CORS_ORIGINS}

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=${NEO4J_USER}
NEO4J_PASSWORD=${NEO4J_PASSWORD}
NEO4J_DATABASE=neo4j

UPLOAD_DIR=/app/data/uploads
MODEL_DIR=/app/data/models
LOG_DIR=/app/data/logs
MAX_UPLOAD_SIZE_MB=500

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90

TPKE_CONFIDENCE_THRESHOLD=0.70
TPKE_FREQUENCY_THRESHOLD=3
TPKE_TOP_K=3
TPKE_DECAY_RATE=0.05
TPKE_REMOVAL_THRESHOLD=0.10
TPKE_WINDOW_SIZE_DAYS=30

NGINX_PORT=80
NEO4J_BROWSER_PORT=7474
VITE_API_BASE_URL=${VITE_API_BASE_URL}
