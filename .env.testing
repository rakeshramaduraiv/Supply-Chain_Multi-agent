# ============================================================
# AMASCI - Testing Environment
# ============================================================

APP_NAME=AMASCI
APP_VERSION=1.0.0
APP_ENV=testing
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1

SECRET_KEY=test-secret-key-for-ci-pipeline-xyz789
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
CORS_ORIGINS=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=amasci_test
POSTGRES_PASSWORD=amasci_test_pass
POSTGRES_DB=amasci_test_db
DATABASE_URL=postgresql+asyncpg://amasci_test:amasci_test_pass@localhost:5432/amasci_test_db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_test_pass
NEO4J_DATABASE=neo4j

UPLOAD_DIR=./data/test_uploads
MODEL_DIR=./data/test_models
LOG_DIR=./data/test_logs
MAX_UPLOAD_SIZE_MB=50

LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=1

TPKE_CONFIDENCE_THRESHOLD=0.70
TPKE_FREQUENCY_THRESHOLD=3
TPKE_TOP_K=3
TPKE_DECAY_RATE=0.05
TPKE_REMOVAL_THRESHOLD=0.10
TPKE_WINDOW_SIZE_DAYS=30
