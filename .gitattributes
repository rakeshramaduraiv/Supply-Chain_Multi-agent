# Git LFS tracking
# Only track files that cannot be regenerated without the raw dataset.

# ML model binaries (not regenerable without full training run)
*.pkl filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text

# Parquet files (binary, large — regenerable but kept for convenience)
*.parquet filter=lfs diff=lfs merge=lfs -text

# Holdout actuals — the four real held-out months (not regenerable without raw CSV)
backend/data/actuals_real/*.csv filter=lfs diff=lfs merge=lfs -text

# NOTE: Stage CSVs, feature-group CSVs, and all other pipeline outputs are
# excluded from git entirely via .gitignore. They are regenerated by
# `make bootstrap` followed by initialization.
