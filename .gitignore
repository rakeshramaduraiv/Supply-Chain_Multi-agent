# ============================================================
# AMASCI - Root Git Ignore
# ============================================================

# Environment files with secrets
.env
.env.local
.env.*.local
.env.production

# Keep templates
!.env.development
!.env.testing
!.env.production

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
venv/
.venv/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data - logs only (runtime artifacts)
backend/data/logs/*
!backend/data/logs/.gitkeep

# Large data files (exceed GitHub 100MB limit)
backend/data/raw/*.csv
data/raw/*.csv

# Parquet files (binary, large, regenerable)
backend/data/stages/*.parquet
backend/data/stages/**/*.parquet
data/stages/*.parquet
data/stages/**/*.parquet
backend/data/uploads/*.parquet
backend/uploads/*.parquet

# Backup data files
*_FULL_BACKUP.csv
*_train.csv

# Runtime output files (regenerated on each run)
*.txt
af_test.json
diag_test.json
retrain_result.txt
retrain2.txt
*_out.txt

# One-off debug/fix scripts (not part of the application)
_debug*.py
_compute*.py
check_*.py
fix_*.py
verify_*.py
wire_*.py
rewire_*.py
find_area*.py
inspect_*.py
regen_*.py
run_init.py

# Docker volumes
postgres_data/
neo4j_data/

# Build artifacts
*.log
*.pid

# Backups
*.sql.gz
*.dump.gz
