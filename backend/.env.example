# ============================================================
# AMASCI - Environment Configuration Template
# Copy to .env and fill in values
# ============================================================

# --- Application ---
APP_NAME=AMASCI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Security ---
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=amasci_user
POSTGRES_PASSWORD=amasci_password
POSTGRES_DB=amasci_db
DATABASE_URL=postgresql+asyncpg://amasci_user:amasci_password@localhost:5432/amasci_db

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models
LOG_DIR=./data/logs
MAX_UPLOAD_SIZE_MB=500

# --- ML Configuration ---
ML_MODEL_VERSION=latest
LIGHTGBM_N_ESTIMATORS=500
LIGHTGBM_LEARNING_RATE=0.05
LIGHTGBM_MAX_DEPTH=7

# --- TPKE Configuration ---
TPKE_CONFIDENCE_THRESHOLD=0.6
TPKE_FREQUENCY_THRESHOLD=3
TPKE_DECAY_RATE=0.1
TPKE_WINDOW_SIZE_DAYS=90

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./data/logs/amasci.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
