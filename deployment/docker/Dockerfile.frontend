# ============================================================
# AMASCI Frontend - Production Multi-Stage Dockerfile
# Node build + Nginx static serving
# ============================================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS dependencies

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

# --- Stage 2: Build ---
FROM node:22-alpine AS build

WORKDIR /build

COPY --from=dependencies /build/node_modules ./node_modules
COPY frontend/ .

ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# --- Stage 3: Production (Nginx) ---
FROM nginx:1.25-alpine AS production

RUN rm -rf /usr/share/nginx/html/* \
    && rm /etc/nginx/conf.d/default.conf

COPY --from=build /build/dist /usr/share/nginx/html
COPY deployment/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deployment/nginx/default.conf /etc/nginx/conf.d/default.conf

RUN adduser -D -H -u 1001 -s /sbin/nologin amasci \
    && chown -R amasci:amasci /usr/share/nginx/html \
    && chown -R amasci:amasci /var/cache/nginx \
    && chown -R amasci:amasci /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown -R amasci:amasci /var/run/nginx.pid

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
