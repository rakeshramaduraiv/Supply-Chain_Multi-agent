# ============================================================
# AMASCI - Scheduled Tasks (Crontab)
# Install: crontab deployment/monitoring/crontab
# ============================================================

# Health check every 5 minutes
*/5 * * * * /opt/amasci/deployment/monitoring/health-check.sh >> /var/log/amasci/health.log 2>&1

# PostgreSQL backup daily at 2:00 AM
0 2 * * * /opt/amasci/deployment/backup/backup-postgres.sh >> /var/log/amasci/backup.log 2>&1

# Neo4j backup daily at 3:00 AM
0 3 * * * /opt/amasci/deployment/backup/backup-neo4j.sh >> /var/log/amasci/backup.log 2>&1

# Log rotation daily at 4:00 AM
0 4 * * * /usr/sbin/logrotate /opt/amasci/deployment/monitoring/logrotate.conf

# Cleanup old Docker images weekly on Sunday at 5:00 AM
0 5 * * 0 docker image prune -af --filter "until=168h" >> /var/log/amasci/cleanup.log 2>&1
